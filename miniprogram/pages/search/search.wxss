/* pages/search/search.wxss */
.tuchu{
    color: goldenrod;
}
.flex{
    display: flex;
}
.searchWord{
    /* flex: 1; */
    /* width: 60rpx; */
    margin: 10rpx 50rpx;
}
.biaoti{
    text-align: center;
    padding: 32rpx;
}
.yincangwenzi{
    display: -webkit-box;
    word-break: break-all;
    text-overflow: ellipsis;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

/* 店铺列表 */
.dianpu {
    display: flex;
    border-bottom: 1rpx solid #cdcdcd;
    padding: 30rpx;
    font-size: 24rpx;
    color: dimgray;
  }
  
  .dianpu_you {
    margin-left: 20rpx;
  }
  
  .dianpu_you_1{
    font-weight: bolder;
    font-size: 32rpx;
    color: black;
  
  }
  
  .dianpu_you_2 {
    justify-content: space-between;
    display: flex;
  }
  
  /* .dianpu_you_3 {
    font-size: 24rpx;
    color: dimgray;
  } */
  
  .dianpu_you_4 {
    display: flex;
  
    margin-top: 10rpx;
  
  }
  
  .dianpu_you_4_items {
    margin-left: 10rpx;
  }
  
  .dianpu_you_4_2 {
    text-align: center;
    font-weight: 600;
    display: -webkit-box;
    word-break: break-all;
    text-overflow: ellipsis;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }
  
  .dianpu_you_4_3 {
