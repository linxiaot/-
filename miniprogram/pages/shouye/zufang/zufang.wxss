.yincang {
  display: -webkit-box;
  word-break: break-all;
  text-overflow: ellipsis;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tuijian {
  justify-content: end;
  font-size: small;
  color: gold
}
.yixiajia {
  margin-left: 15rpx;
  border-radius: 15rpx;
  background-color: #f0f0f07c;
  padding: 0rpx 8rpx;
  color: gray;
  font-size: small;
}

.zufang_title {
  display: -webkit-box;
  word-break: break-all;
  text-overflow: ellipsis;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  width: 385rpx;
  font-size: 32rpx;
}