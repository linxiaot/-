                        <view wx:if="{{!item.isOpen_qita}}" style="color: red;">已关闭</view>
                        <view wx:if="{{item.isOpen_qita}}">已开启</view>
                    </view>
                </view>
                <view class="choose_item3" style="width: 80rpx;color: red;" catchtap="todel_qita" data-index="{{index}}">
