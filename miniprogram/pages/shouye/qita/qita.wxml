<view style="display: flex;margin-top: 30rpx;" wx:if="{{isAdmin}}">
    <button type="primary" size="mini" catchtap="onEdit_start" wx:if="{{!isEdit}}">编辑</button>
    <button type="warn" plain="true" size="mini" catchtap="onEdit_end" wx:if="{{isEdit}}">取消</button>
</view>
<view class="qita" wx:if="{{!isEdit}}">
    <!-- <view class="qita_items" catchtap="toDetail_qita" wx:if="{{isOpen_qita}}">
        <view class="qita_item1">大巴车预订</view>
    </view> -->
    <view class="qita_items" catchtap="{{item.isOpen_qita?'toDetail_qita':'toDetail_qita_close'}}" wx:for="{{qitaResdata}}" wx:key="index" data-id="{{item._id}}" wx:if="{{qitaResdata.length !== 0}}">
        <view class="qita_item1">{{item.text_qita.text_title}}</view>
    </view>
    <!-- <view class="qita_items" catchtap="toJinshuju" wx:for="{{input_list}}" wx:key="index" data-index="{{index}}" wx:if="{{input_list.length !== 0}}">
        <view class="qita_item1">{{item.title}}</view>
    </view> -->
    <view class="weui-loadmore weui-loadmore_line weui-loadmore_dot" wx:if="{{isGengDuo}}" style="font-size: small;color: gray;">到底了
        </view>
</view>
<!-- 编辑时显示 -->
<view class="qita" wx:if="{{ isAdmin&&isEdit }}">
