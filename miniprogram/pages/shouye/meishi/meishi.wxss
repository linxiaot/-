.page_dianpu {
  display: flex;
  flex-direction: column;
  /* background-color: orange; */
}

.xuanka {
  background: white;
}

/* 折扣信息区 */

.discount {
  width: 100%;
  /* height: 70rpx; */
  line-height: 70rpx;
  background: white;
  font-size: 28rpx;
  text-align: center;
  color: #999;
}

.discount-txt {
  color: #fff;
  padding: 5rpx 10rpx;
  background: red;
  margin-right: 15rpx;
}

.content {
  flex: 1;
  display: flex;
  /* height: 1200rpx; */
}

/* 左侧菜单 */

.category {
  width: 202rpx;
  height: 100%;
  background: #fcfcfc;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
}

.category_item {
  /* height: 100rpx; */
  line-height: 100rpx;
  text-align: center;
}

/* 隐藏滚动条 */

::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.category_unselect {
  color: #6c6c6c;
  background: #f9f9f9;
  border-bottom: 1rpx solid #e3e3e3;
}

.category_selected {
  color: #ff9c35;
  border-left: 6rpx solid #ff9c35;
  background: white;
}

/* 右侧菜单 */

.food_category {
  font-size: 25rpx;
  background: #eaeaec;
  padding: 10rpx;
  color: #ff9c35;
  height: 50rpx;
}

.food_item {
  display: flex;
  flex-direction: row;
  margin: 40rpx 20rpx;
}

.food-item-pic {
  margin-right: 20rpx;
  width: 152rpx;
  height: 114rpx;
}

.food-item-pic>image {
  width: 100%;
  height: 100%;
}

.food-item-info {
  flex: 1;
  font-size: 30rpx;
  margin-top: 4rpx;
}

.food-item-price {
  margin-top: 14rpx;
  color: #f05a86;
}

.food-item-opt {
  margin-top: 40rpx;
}

.food-item-opt>image {
  width: 40rpx;
  height: 40rpx;
}

.food-item-opt>i:before {
  font-size: 44rpx;
  color: #ff9c35;
  content: "\e728";
}

/* 满减区域 */

.promotion {
  height: 40rpx;
  background: #ffcd9b;
  color: #fff7ec;
  font-size: 24rpx;
  text-align: center;
}

/* 底部菜单操作 */
.dibucaozuo {
  position: absolute;
  width: 750rpx;
}

.operate {
  height: 65px;
  display: flex;
}

.operate-shopcart {
  width: 74%;
  padding: 10rpx;
  background: #353535;
}

.operate-submit {
  width: 26%;
  font-size: 30rpx;
  background: #eee;
  color: #aaa;
  text-align: center;
  line-height: 110rpx;
}

.operate-submit-activity {
  background: #ff9c35;
  color: #fff;
}

.operate-shopcart {
  display: flex;
}

.operate-shopcart-icon {
  font-size: 80rpx;
  color: #ffffff00;
  margin-left: 20rpx;
  position: relative;
}

.operate-shopcart-icon:before {
  content: "\e73c";
}

.operate-shopcart-icon-activity {
  color: #ff9c35;
}

.operate-shopcart-icon>span {
  padding: 2rpx 14rpx;
  border-radius: 50%;
  background: red;
  color: white;
  font-size: 28rpx;
  position: absolute;
  text-align: center;
  top: 0px;
  right: -10rpx;
}

.gouwucheNum {
  padding: 2rpx 14rpx;
  border-radius: 50%;
  background: red;
  color: white;
  font-size: 28rpx;
  position: absolute;
  text-align: center;
  top: 0px;
  right: -10rpx;
}

.operate-shopcart-ball {
  width: 36rpx;
  height: 36rpx;
  position: fixed;
  border-radius: 50%;
  left: 50%;
  top: 50%;
  background: #ff9c35;
}

.operate-shopcart-empty {
  color: #a9a9a9;
  line-height: 88rpx;
  font-size: 30rpx;
  margin-left: 20rpx;
}

.operate-shopcart-price {
  display: flex;
}

.operate-shopcart-price>view {
  font-size: 40rpx;
  line-height: 88rpx;
  margin-left: 25rpx;
  color: #fff;
}

.operate-shopcart-price>text {
  font-size: 24rpx;
  line-height: 92rpx;
  margin-left: 15rpx;
  color: #aaa;
  text-decoration: line-through;
}

.shopcart {
  position: fixed;
  top: 0;
  left: 0;
  /* bottom: 149rpx; */
  bottom: 65px;
  right: 0;
  font-size: 28rpx;
}

.shopcart-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: #000;
  opacity: 0.5;
}

.shopcart-wrap {
  position: absolute;
  width: 100%;
  max-height: 90%;
  bottom: 0;
  background: #fff;
  overflow: scroll;
}

.shopcart-head {
  position: fixed;
  width: 100%;
  background: #f0f0f0;
  color: #878787;
  line-height: 100rpx;
  font-size: 26rpx;
  overflow: hidden;
}

.shopcart-head-title {
  float: left;
  margin-left: 40rpx;
}

.shopcart-head-title:before {
  background: #ff9c35;
  width: 8rpx;
  height: 32rpx;
  content: "";
  display: inline-block;
  margin-right: 10rpx;
  position: relative;
  top: 6rpx;
}

.shopcart-head-clean {
  float: right;
  margin-right: 20rpx;
}

.shopcart-head-clean>i:before {
  content: "\e61b";
  position: relative;
  top: 2rpx;
}

.shopcart-list {
  margin-top: 101rpx;
}

.shopcart-item {
  display: flex;
  padding: 30rpx 20rpx;
  line-height: 40rpx;
}

.shopcart-item>view {
  margin-left: 30rpx;
}

.shopcart-item:not(:last-child) {
  border-bottom: 1rpx solid #e3e3e3;
}

.shopcart-item-name {
  flex: 1;
}

.shopcart-item-price {
  color: #ff9c35;
}

.shopcart-item-number {
  display: flex;
}

.shopcart-item-number>view {
  margin: 0 15rpx;
}

.shopcart-icon-dec:before {
  content: "\e61a";
  font-size: 44rpx;
  color: #888;
}

.shopcart-icon-add:before {
  content: "\e728";
  font-size: 44rpx;
  color: #ff9c35;
}

.iconfont {
  font-family: "iconfont" !important;
  font-size: 32rpx;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
}

/* 店铺 */
.dianpu {
  height: 80px;
  padding: 20rpx 30rpx;

}

.dianpu_1 {
  display: flex;
  height: 120rpx;
}

.dianpu_zhaopai {
  width: 120rpx;
  height: 120rpx;
  /* border:2rpx solid gold ; */
}

.dianpu_name {
  font-size: large;
}
.dianpu_item {
  font-size: 24rpx;
  background-color: #E5E7E6;
  margin-right: 10rpx;
  padding: 0rpx 10rpx;
  border-radius: 5rpx;
}

.dianpu_gonggao {
  font-size: 24rpx;
  display: -webkit-box;
  word-break: break-all;
  text-overflow: ellipsis;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.pingjia_tou{
  display: flex;
  justify-content: center;
  align-items: center;
}
.pingjia_tou_item{
  font-size: 50rpx;
  font-weight: bold;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.xingji2 {
  height: 100rpx;
  justify-content: center;
  align-items: center;
  display: flex;
  flex-direction: column;
}

.xingji {
  display: flex;
  justify-content: flex-start;
  /* margin: 80rpx; */
}

.xingji_items1 {
  /* flex: 1; */
  display: flex;
  /* justify-content: space-between; */
  margin-right: 10rpx;
}

.xingji_items2 {
  /* flex: 1; */
  text-align: center;
  font-size: small;
  color: gray;
}

.pingjia {
  margin-bottom: 50rpx;
}

.pingjia_items {
  background-color: white;
  border-top: 2rpx solid #f0f0f0;
  margin-bottom: 0rpx;
  padding: 20rpx;
}

.pingjia_item1 {
  margin-bottom: 20rpx;
}

.pingjia_item2 {
  font-size: 26rpx;
}

.weui-media-box{
  padding: 10rpx 32rpx;
}
.dianpuxiangqing{
  margin-top: 20rpx;
  font-size: small;
}