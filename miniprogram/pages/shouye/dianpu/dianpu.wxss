/* pages/shouye/dianpu/dianpu.wxss */
.categoryList {
  width: 100%;
  height: 350rpx;
  border-bottom: 20rpx solid #f4f4f4;
}

.category-info {
  display: inline-block;
  text-align: center;
  position: relative;
  margin-top: 20rpx;
  height: 150rpx;
  width: 25%;
}

.category-image {
  width: 95rpx;
  height: 95rpx;
}

.category-text {
  font-size: 25rpx;
  width: 100%;
  line-height: 30rpx
}

.paixu{
  padding: 0rpx 10rpx;
}

.paixuhetianjia {
  /* justify-content: space-between; */
  display: flex;
  font-size: 28rpx;
  margin: 20rpx;
}

.paixuhetianjia view {
  /* margin-bottom: 0; */
}

.hover {
  opacity: 0.8;
  background: #dcdcdc;
  color: goldenrod;
}

.mask {
  width: 100%;
  height: 100%;
  position: absolute;
  z-index: 999;
  background-color: rgba(15, 15, 26, 0.7);
}

/* 筛选 */
.overall-sort-list,
.filterList,
.filterList-footer {
  background: white;
}

.overall-sort-list {
  flex-direction: column;
  border-top: 1px solid rgba(0, 0, 0, 0);
  display: flex;
}

.overall-sort {
  font-size: 25rpx;
  height: 70rpx;
  line-height: 70rpx;
  margin-left: 30rpx;
}

/* 筛选 */
.filterList {
  height: 500rpx;
  font-size: 27rpx;
  overflow: hidden;
}

.filterList-quyu-title,
.filterList-zujin-title {
  position: relative;
  height: 50rpx;
  line-height: 50rpx;
  background: #FBFBFB;
  font-weight: 400;
  padding-left: 30rpx;
}

.filterList-quyu-title::before,
.filterList-zujin-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 15rpx;
  display: inline-block;
  width: 5rpx;
  height: 20rpx;
  background: #FED161;
}

.filterList-quyu-items {
  height: 200rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-content: space-around;
}

.filterList-quyu-item {
  text-align: center;
  height: 70rpx;
  width: 200rpx;
  margin: 0 20rpx;
  border-radius: 70rpx;
  border: 2rpx solid #ECECEC;
  line-height: 70rpx;
}

.filterList-zujin-item-icon {
  padding: 0 4rpx;
  color: white;
}

.filterList-zujin-item {
  margin-left: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-bottom: 1rpx solid #ECECEC;
}

.filterList-footer {
  height: 90rpx;
  display: flex;
}

.filterList-footer-delect {
  flex: 1;
  font-size: 25rpx;
  line-height: 90rpx;
  padding-left: 30rpx;
}

.filterList-footer-finish {
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  line-height: 90rpx;
  font-size: 35rpx;
  width: 210rpx;
  background: #FFD161;
  position: relative;
}

.filterList-footer-finish-number {
  height: 30rpx;
  width: 30rpx;
  line-height: 31rpx;
  font-size: 25rpx;
  margin-left: 15rpx;
  color: #FFD161;
  border-radius: 50%;
  background: black;
}

.quyu-selected {
  background: #FFFBF1;
  border-color: #FFE9B7;
  /* color: #FFE6B4; */
  color: goldenrod;
}

.zujin-selected {
  color: goldenrod;
}

/* 店铺列表 */
.dianpu {
  display: flex;
  border-bottom: 1rpx solid #cdcdcd;
  padding: 30rpx;
  font-size: 24rpx;
  color: dimgray;
}

.dianpu_you {
  margin-left: 20rpx;
}

.dianpu_you_1{
  font-weight: bolder;
  font-size: 32rpx;
  color: black;

}

.dianpu_you_2 {
  /* justify-content: space-between; */
  display: flex;
}

/* .dianpu_you_3 {
  font-size: 24rpx;
  color: dimgray;
} */

.dianpu_you_4 {
  display: flex;

  margin-top: 10rpx;

}

.dianpu_you_4_items {
  margin-left: 10rpx;
}

.dianpu_you_4_2 {
  text-align: center;
  font-weight: 600;
  display: -webkit-box;
  word-break: break-all;
  text-overflow: ellipsis;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.dianpu_you_4_3 {
  text-align: center;
  font-weight: 600;
  color: red;
}

