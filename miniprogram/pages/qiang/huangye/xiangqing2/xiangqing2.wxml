<!-- 黄页 -->
<view class="page__bd" wx:if="{{detailType == 'huangye'}}">
    <view class="weui-article">
        <view class="weui-article__h1">{{name}}</view>
        <view class="weui-article__section">
            <!-- <view class="weui-article__h2">章标题</view> -->
            <view class="weui-article__section">
                <view class="flex" style="margin-left:10rpx;" bindtap="toLookuserinfo">
                    <image mode="widthFix" style="width:50rpx;" src="{{avatarUrl}}"></image>
                    <view class="" style="margin-left:15rpx;font-size:30rpx;font-weight:bold">{{nickName}}</view>
                </view>
                <view class="flex" style="justify-content:flex-end;font-size:25rpx;">{{createTime}}</view>
                <view class="weui-article__h3 cebian">简介</view>
                <view class="weui-article__p">{{jianjie}}</view>
                <view class="weui-article__p flex center" wx:for="{{srcList}}" wx:key="index">
                    <image class="weui-article__img" src="{{item}}" mode="widthFix" style="width:680rpx;" />
                </view>
            </view>
            <view class="weui-article__section">
                <view class="weui-article__h3 cebian">联系信息</view>
                <view class="weui-article__p">
                    地址：{{address}}
                </view>
                <view class="weui-article__p">电话：{{phone}}</view>
                <!-- <ad unit-id="adunit-13f753f084bf337f" ad-type="video" ad-theme="white"></ad> -->
            </view>
        </view>
    </view>
</view>
