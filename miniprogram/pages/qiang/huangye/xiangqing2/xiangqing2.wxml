        <view class="weui-article__h1">{{name}}</view>
        <view class="weui-article__section">
            <!-- <view class="weui-article__h2">章标题</view> -->
            <view class="weui-article__section">
                <!-- <view class="flex" style="margin-left:10rpx;">
                    <image mode="widthFix" style="width:50rpx;" src="{{avatarUrl}}"></image>
                    <view class="" style="margin-left:15rpx;font-size:30rpx;font-weight:bold">{{nickName}}</view>
                </view> -->
                <view class="flex" style="justify-content:flex-end;font-size:25rpx;">{{createTime}}</view>
                <!-- <view class="weui-article__h3 cebian">简介</view> -->
                <text class="weui-article__p">{{jianjie}}</text>

                <view wx:if="{{video_fileid}}">
                    <video class="pengyq_video" src="{{video_fileid}}" autoplay="{{autoplay}}" muted="{{isMuted}}"
                        show-mute-btn bindfullscreenchange="bind_quanping"></video>
                </view>

                <view class="audio" wx:if="{{audio.fileid}}">
                    <view class="audio_item1">
                        <view class="jiahao_audio" bindtap="toAddAudio" wx:if="{{audio_path == ''}}">
                            <view>+</view>
                        </view>
                        <image wx:if="{{!isPlay && audio_path !== ''}}" mode="widthFix" style="width: 60rpx;"
                            src="cloud://xmf-0g87mzf198205ada.786d-xmf-0g87mzf198205ada-1305629196/banner/tubiao/qiang/play.png" bindtap="audioPlay"
                            data-src="{{item.audio.fileid}}">
                        </image>
                        <image wx:if="{{isPlay && audio_path !== ''}}" mode="widthFix" style="width: 60rpx;"
                            src="cloud://xmf-0g87mzf198205ada.786d-xmf-0g87mzf198205ada-1305629196/banner/tubiao/qiang/pause.png" bindtap="audioPause"
                            data-src="{{item.audio.fileid}}">
                        </image>
                    </view>
                    <view class="audio_items">
                        <view class="audio_items_item1">
                            <view class="audio_items_item1_item1">{{audio.name}}</view>
                            <view class="audio_items_item1_item2">{{currentTime}} / {{duration}}</view>
                        </view>
                        <view class="audio_items_item2">
                            <slider class="slider" activeColor="#8AD4AF" block-size="12" backgroundColor="#dadada"
                                value="{{percent}}" />
                        </view>
                    </view>

                </view>

                <view class="weui-article__p flex center" wx:for="{{srcList}}" wx:key="index">
                    <image class="weui-article__img" src="{{item}}" mode="widthFix" style="width:680rpx;" />
                </view>

            </view>
            <!-- <view class="weui-article__p lianxi flex center">
                <button open-type="contact" class="weui-cell__bd ziti"
                    style="font-weight:normal; text-align: center; padding-left: 72rpx;width: 100%;">在线客服</button>
            </view> -->
            <!-- <view class="weui-article__section">
                <view class="weui-article__h3 cebian">联系信息</view>
                <view class="weui-article__p">
                    地址：{{address}}
                </view>
                <view class="weui-article__p">电话：{{phone}}</view>
                <ad unit-id="adunit-13f753f084bf337f" ad-type="video" ad-theme="white"></ad>
            </view> -->
        </view>
    </view>
</view>
