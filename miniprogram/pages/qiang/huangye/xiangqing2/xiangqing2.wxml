<!-- 底部 -->
<view class="page__bd"
    wx:if="{{detailType == 'pinche'|| detailType == 'xunwu'|| detailType == 'ershou'|| detailType == 'huzhu'|| detailType == 'bigthings'|| detailType == 'luntan'|| detailType == 'jiaoyou'|| detailType == 'jianzhi'}}">
    <view class="weui-article">
        <!-- 广告 -->
        <!-- <ad unit-id="adunit-13f753f084bf337f" ad-type="video" ad-theme="white"></ad> -->
        <!-- 点赞 -->
        <view class="dianzan" catchtap="toLike" data-id="{{item._id}}">
            <view>
                <mp-icon wx:if="{{!isLike}}" icon="like" type="outline" color="black" size="{{26}}"></mp-icon>
                <mp-icon wx:if="{{isLike}}" icon="like" type="field" color="goldenrod" size="{{26}}"></mp-icon>
            </view>
            <text style="font-size:small;"> 赞 {{dianzanNum}}</text>
        </view>
        <!-- 留言 -->
        <view class="liuyan" bindtap="openLiuyan">写下你的留言</view>
        <view class="fadeIn" wx:if="{{isShowliuyan}}">
            <view class="weui-mask" bindtap="closeLiuyan"></view>
            <view class="weui-half-screen-dialog">
                <view class="weui-half-screen-dialog__hd">
                    <view class="weui-half-screen-dialog__hd__side" bindtap="closeLiuyan">
                        <a class="weui-icon-btn">关闭<i class="weui-icon-close-thin"></i></a>
                    </view>
                    <view class="weui-half-screen-dialog__hd__main">
                        <strong class="weui-half-screen-dialog__title">写留言</strong>
                    </view>
                    <view>
                        <button type="primary" size="mini" bindtap="toTijiao_liuyan"
                            disabled="{{inputVal_liuyan!==''?false:true}}">提交</button>
                    </view>
                </view>
                <view class="weui-half-screen-dialog__bd" style="padding-top:10rpx;height:600rpx;">
                    <textarea name="" style="height:600rpx;width:650rpx;" auto-focus maxlength='500'
                        placeholder-style="留言将对所有人可见" bindinput="bindinput_liuyan"
                        value="{{inputVal_liuyan}}"></textarea>
                </view>
            </view>
        </view>
        <view class="fadeIn" wx:if="{{isShowjiaohu}}">
            <view class="weui-mask" bindtap="closeLiuyan"></view>
            <view class="weui-half-screen-dialog">
                <view class="weui-half-screen-dialog__hd">
                    <view class="weui-half-screen-dialog__hd__side" bindtap="closeLiuyan">
                        <a class="weui-icon-btn">关闭<i class="weui-icon-close-thin"></i></a>
                    </view>
                    <view class="weui-half-screen-dialog__hd__main">
                        <strong class="weui-half-screen-dialog__title">回复：{{nickName}}</strong>
                    </view>
                    <view>
                        <button type="primary" size="mini" bindtap="toTijiao_liuyan"
                            disabled="{{inputVal_liuyan!==''?false:true}}">提交</button>
                    </view>
                </view>
                <view class="weui-half-screen-dialog__bd" style="padding-top:10rpx;height:600rpx;">
                    <textarea style="height:600rpx;width:650rpx;" auto-focus maxlength='500'
                        placeholder-style="留言将对所有人可见" bindinput="bindinput_liuyan"
                        value="{{inputVal_liuyan}}"></textarea>
                </view>
            </view>
        </view>
        <!-- 留言展示 -->
        <view>
            <view class="flex liuyanzhanshi" wx:for="{{liuyanList}}" wx:key="index" data-index="{{index}}"
                data-nickname="{{item.nickName}}" bindtap="toJiaohu">
                <view>
                    <image mode="widthFix" style="width:50rpx;" src="{{item.avatarUrl}}"></image>
                </view>
                <view style="margin-left:15rpx;font-size:25rpx;">
                    <view style="display:flex;">
                        <view class="" style="color:DarkGray">{{item.nickName}}</view>
                        <view class="author" wx:if="{{item.openid == _openid ? true : false}}">作者</view>
                    </view>
                    <view>{{item.value}}</view>
                    <view style="color:darkblue" catchtap="toDelliuyan"
                        wx:if="{{item.openid == userOpenid ? true : false}}" data-index="{{index}}"
                        data-liuyan_val="{{item.value}}" data-floor="0">删除</view>
                    <view>
                        <view class="flex liuyanzhanshi" wx:for="{{item.jiaohu}}" wx:key="index" data-index="{{index}}">
                            <view>
                                <image mode="widthFix" style="width:50rpx;" src="{{item.avatarUrl}}"></image>
                            </view>
                            <view style="margin-left:15rpx;font-size:25rpx;">
                                <view style="display:flex;">
                                    <view class="" style="color:DarkGray">{{item.nickName}}
                                    </view>
                                    <view class="author" wx:if="{{item.openid == _openid ? true:false}}">作者
                                    </view>
                                </view>
                                <view>{{item.value}}</view>
                                <view style="color:darkblue" wx:if="{{item.openid == userOpenid ? true : false}}"
                                    data-index="{{index}}" catchtap="toDelliuyan" data-floor="1"
                                    data-liuyan_val="{{item.value}}" data-jiaohuindex="{{item.jiaohuIndex}}">删除</view>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
            <view style="text-align:center;color:LightGrey;">————.————</view>
        </view>
    </view>
</view>
