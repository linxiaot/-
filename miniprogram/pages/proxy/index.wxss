.container {
  padding: 20rpx;
}

.time-section {
  background: #fff;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.time-item {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.time-item:last-child {
  margin-bottom: 0;
}

.tag {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
}

.action-section {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.query-btn, .notify-btn {
  flex: 1;
  margin: 0 10rpx;
}

.query-btn {
  background: #007AFF;
  color: #fff;
}

.notify-btn {
  background: #07c160;
  color: #fff;
}

.log-section {
  margin-top: 40rpx;
}

.log-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 1rpx solid #ddd;
  color: #666;
}

.log-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
} 