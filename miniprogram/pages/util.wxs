// 限制字符串显示长度

var filterStr = function (str, limit) {
  return str.length > limit ? str.substring(0, limit) + "..." : str
}

function indexOf(str, word) {
  console.log('indexOf', str.indexOf(word));
  return str.indexOf(word)
}

module.exports = {
  filterStr: filterStr,
  indexOf: indexOf
}


