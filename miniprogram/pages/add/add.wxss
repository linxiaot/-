/* pages/add/add.wxss */
.flexinput {
    display: flex;
}

.tanchu {
    /* width: 750rpx; */
    height: 100%;
    margin-bottom: 100rpx;
}

.tanchuBiaoti {
    margin: 50rpx 0rpx;
    text-align: center;
}

.tanchuRow {
    padding-left: 50rpx;
    /* padding-right: 50rpx; */
    margin-right: 50rpx;
}

.tanchuRow>view:first-child {
    font-size: small;
}

.jianjie textarea {
    border-radius: 10rpx;
    /* background-color: #f0f0f0; */
}

.mask {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: #3333336b;
    box-shadow: 0 0 2px rgba(0, 0, 0, 0.1);
    z-index: 101;
    display: flex;
}

.untap {
    color: gray;
}

.sheshi {
    display: flex;
    flex-direction: row;
}

.sheshi_item {
    /* background-color: #dcdcdc; */
    padding: 0rpx 15rpx;
    margin: 0 15rpx;
    border-radius: 27rpx;
}

/* checkbox未选中时样式 */
.checkbox .wx-checkbox-input {
    border-radius: 3rpx;
    height: 26rpx;
    width: 26rpx;
    margin-top: 0rpx;
    display: flex;
}

.sheshi_gengduo {
    color: darkblue;
    font-size: small;
    margin-left: 20rpx;
    display: flex;
    justify-content: flex-end;
}

/* 选择兼职类型 */
.filterList-leixing-items {
    height: 240rpx;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: space-around;
}


.filterList-leixing-item {
    text-align: center;
    height: 50rpx;
    width: 180rpx;
    margin: 0 10rpx;
    border-radius: 50rpx;
    border: 2rpx solid #ECECEC;
    line-height: 50rpx;
    color: darkblue;
}

.leixing-selected {
    background: #FFFBF1;
    border-color: #FFE9B7;
    /* color: #FFE6B4; */
    color: goldenrod;
}

.quyu {
    margin-top: 30rpx;
}

.filterList-zfleixing-items {
    height: 80rpx;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: space-around;
}

.filterList-tupian-items {
    padding: 0 50rpx;
    height: 300rpx;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: space-around;
}

.filterList-tupian-item {
    text-align: center;
    height: 50rpx;
    width: 180rpx;
    margin: 0 10rpx;
    border-radius: 50rpx;
    border: 2rpx solid #ECECEC;
    line-height: 50rpx;
    color: darkblue;
}

.ft_itemsmore {
    padding: 0 50rpx;
    height: 600rpx;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: space-around;
}

.tupian-selected {
    background: #FFFBF1;
    border-color: #FFE9B7;
    /* color: #FFE6B4; */
    color: goldenrod;
    opacity: 0.8;
}

.pengyq_video {
    width: 400rpx;
    height: 300rpx;
}

.video_shanchu{
    width: 400rpx;
    text-align: center;
    color: #F5835E;
    font-size: small;
}

.upvideo {
    padding: 30rpx;
    background-color: white;
}

.uploadxuanxiang {
    margin: 30rpx;
    display: flex;
}

.uploadxuanxiang_item {
    margin-left: 20rpx;
    color: gray;
}

.yixuan {
    border-bottom: 5rpx solid gray;
    color: black;
}

.jiahao{
    width: 200rpx;
    height: 200rpx;
    background-color: #f2f2f2;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 150rpx;
    color: gray;
    font-weight: 100;
}
.video_text{
    margin: 20rpx;
}

.bigthings_jianjie{
    height: 400rpx;
}
.bingthings_text{
    height: 400rpx;
}


.audio{
    width: 560rpx;
    padding: 30rpx;
    background-color: white;
    height: 100rpx;
    border-radius: 5rpx;
    display: flex;
    /* padding: 5rpx; */
    align-items: center;
    color: gray;
    border: 2rpx solid #8AD4AF;
    margin: auto;
  
  }
  .audio_items{
    margin: 0rpx 10rpx;
  }
  .audio_item1{
    width: 100rpx;
    height: 100rpx;
    /* background-color: cornflowerblue; */
    /* margin: 0rpx 5rpx; */
    border-right: 2rpx solid #8AD4AF;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .audio_items_item1{
    width: 450rpx;
    font-size: small;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    
  }
  .audio_items_item1_item1{
    font-size: small;
  }
  .audio_items_item1_item2{
    font-size: 20rpx;
  }
  .audio_items_item2{
    font-size: small;
  }
  .slider{
    margin: 0rpx 0rpx;
    padding: 0rpx 10rpx;
  }
  .jiahao_audio{
    font-size: 50rpx;
    height: 80rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .audio_shanchu{
      margin-top: 20rpx;
    width: 100%;
    text-align: center;
    color: #F5835E;
    font-size: small;
}