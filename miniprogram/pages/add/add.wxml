                <view class="weui-textarea-counter"><span>{{inputNum}}</span>/200</view>
            </view>
        </view>
        <view class="weui-media-box weui-media-box_text  tanchuRow">
            <view style="flex:0.2">联系方式</view>
            <view class="weui-input" style="flex:1">
                <input placeholder="如：加我微信xdxmf0001" type="text" value="{{value_lianxi}}" name="inputVal_lianxi" />
