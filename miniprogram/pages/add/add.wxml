<!-- 黄页 -->
<view class="tanchu" wx:if="{{addType == 'huangye'}}">
    <view class="tanchuBiaoti" wx:if="{{!isEdit}}">填写商家信息</view>
    <view class="tanchuBiaoti" wx:if="{{isEdit}}">编辑商家信息</view>
    <form bindsubmit="toTijiaoSubmit_huangye">
        <view class="weui-media-box weui-media-box_text flex tanchuRow">
            <view style="flex:0.2">名称</view>
            <view class="weui-input" style="flex:1">
                <input placeholder="如：苏记烧烤" type="text" value="{{value_name}}" maxlength="15" name="inputVal_name" />
            </view>
        </view>
        <view class="weui-media-box weui-media-box_text flex tanchuRow">
            <view style="flex:0.2">电话</view>
            <view class="weui-input" style="flex:1">
                <input placeholder="如：13288889999" type="text" value="{{value_phone}}" maxlength="11"
                    name="inputVal_phone" />
            </view>
        </view>
        <view class="weui-media-box weui-media-box_text flex tanchuRow">
            <view style="flex:0.2">类别</view>
            <view class="filterList-leixing-items">
                <block wx:for="{{leibieList}}" wx:key="index">
                    <view class="filterList-leixing-item {{leibieSelected==index?'leixing-selected':''}}"
                        catchtap="leibieSelected" data-index="{{index}}" style="font-size:small;">{{item.text}}</view>
                </block>
            </view>

        </view>
        <view class="weui-media-box weui-media-box_text  tanchuRow">
            <view style="flex:0.2">详细地址</view>
            <view class="weui-input" style="flex:1">
                <input placeholder="如：湘大南门联建美食街直走10号店铺" maxlength="50" type="text" value="{{value_address}}"
                    name="inputVal_address" />
            </view>
        </view>
        <view class="weui-media-box weui-media-box_text  tanchuRow">
            <view style="flex:0.2">地址简称</view>
            <view class="weui-input" style="flex:1">
                <input placeholder="显示在首页 如：联建美食街" type="text" value="{{value_jianAddress}}" maxlength="12"
                    name="inputVal_jianAddress" />
            </view>
        </view>
        <view class="weui-media-box weui-media-box_text  tanchuRow">
            <view style="flex:0.2">简介</view>
            <view class="jianjie" style="flex:1;">
                <textarea class="weui-textarea" placeholder="描述商家服务内容及特色" style="height:250rpx;" maxlength="200"
                    value="{{value_jianjie}}" name="inputVal_jianjie" bindinput="bindinputJianjie" />
                <view class="weui-textarea-counter"><span>{{inputNum}}</span>/200</view>
            </view>
        </view>
        <view wx:if="{{isEdit}}" class="filterList-tupian-items {{imagesUrlList.length>2?'ft_itemsmore':''}} quyu">
            <block wx:for="{{imagesUrlList}}" wx:key="index">
                <view>
                    <view style="width:200rpx;">
                        <image wx:if="{{item.imagetempFileURL !== ''}}" style="width:150rpx;" mode="widthFix"
                            src="{{item.imagetempFileURL}}" catchtap="toAddImage" data-index="{{index}}"></image>
                    </view>
                    <view class="filterList-tupian-item" style="width:110rpx;" hover-class="tupian-selected"
                        catchtap="toDelImage" data-imagefileid="{{item.imagefileID}}" data-index="{{index}}">删除</view>
                </view>
            </block>
            <view style="background-color:gray; margin-bottom:90rpx;" wx:if="{{imagesUrlList.length<5}}">
                <image style="width:150rpx;" mode="widthFix" src="../../images/shangchuantupian.png"
                    catchtap="toAddImage2"></image>
            </view>
        </view>
        <mp-cells wx:if="{{!isEdit}}">
            <mp-cell>
                <mp-uploader select="{{selectFile}}" files="{{files}}" max-count="5" binddelete="todelete" title="图片上传"
                    tips="图片尺寸建议1:1">
                </mp-uploader>
            </mp-cell>
        </mp-cells>
        <button form-type="submit" wx:if="{{isEdit}}" style="position: relative; left: -30rpx; top: 20rpx"
            type="primary" disabled="{{isDisabled}}">确定</button>
        <button form-type="submit" wx:if="{{!isEdit}}" style="position: relative; left: -30rpx; top: 20rpx"
            type="primary" disabled="{{isDisabled}}">提交审核</button>
    </form>
</view>
<!-- 拼车 -->
<view class="tanchu" wx:if="{{addType=='pinche'}}" bindtap="toCloseShijian">
    <view class="tanchuBiaoti" wx:if="{{isEdit}}">拼车编辑</view>
    <view class="tanchuBiaoti" wx:if="{{!isEdit}}">拼车发布</view>
    <form bindsubmit="toTijiaoSubmit_pinche"> 
        <view class="weui-media-box weui-media-box_text flex tanchuRow">
            <view style="flex:0.2">行程</view>
            <view class="weui-input weui-cell" style="flex:1;display:flex;">
                <text style="margin-right:20rpx;">出发:</text>
                <input placeholder="如：湘大" type="text" value="{{value_xingch_start}}" name="inputVal_xingch_start" />
            </view>
            <view class="weui-input weui-cell" style="flex:1;display:flex;">
                <text style="margin-right:20rpx;">终点:</text>
                <input placeholder="如：湘潭北站" type="text" value="{{value_xingch_end}}" name="inputVal_xingch_end" />
            </view>
        </view>
        <view class="weui-media-box weui-media-box_text flex tanchuRow">
            <view style="flex:0.2">日期</view>

            <view class="selected-date" catchtap="toOpenShijian">{{month}}月{{day}}日</view>
            <!-- <view class="selected-date" catchtap="toOpenShijian">{{year}}年{{month}}月{{day}}日{{daytime}}{{time}}点</view> -->
            <picker-view wx:if="{{isShowshijian}}" mask-class="mask" indicator-style="height: 50px;"
                style="width: 100%; height: 300px;" value="{{val}}" bindchange="bindChange">
                <!-- <picker-view-column>
                    <view wx:for="{{years}}" wx:key="index" style="line-height: 50px; text-align: center;">{{item}}年
                    </view>
                </picker-view-column> -->
                <picker-view-column>
                    <view wx:for="{{months}}" wx:key="index" style="line-height: 50px; text-align: center;">
                        {{item}}月</view>
                </picker-view-column>
                <picker-view-column>
                    <view wx:for="{{days}}" wx:key="index" style="line-height: 50px; text-align: center;">{{item}}日
                    </view>
                </picker-view-column>
                <!-- <picker-view-column>
                    <view wx:for="{{daytimes}}" wx:key="index" style="line-height: 50px; text-align: center;">{{item}}
                    </view>
                </picker-view-column>
                <picker-view-column>
                    <view wx:for="{{times}}" wx:key="index" style="line-height: 50px; text-align: center;">{{item}}
                    </view>
                </picker-view-column> -->
            </picker-view>
        </view>
        <view class="weui-media-box weui-media-box_text flex tanchuRow">
            <view style="flex:0.2">时间</view>
            <view class="weui-input" style="flex:1">
                <input placeholder="如：上午,或09:30" type="text" value="{{value_shijian}}" name="inputVal_shijian" />
            </view>

        </view>
        <view class="weui-media-box weui-media-box_text  tanchuRow">
            <view style="flex:0.2">人数</view>
            <view class="weui-input" style="flex:1">
                <input placeholder="如：3人" type="text" value="{{value_personNum}}" name="inputVal_personNum" />
            </view>
        </view>
        <view class="weui-media-box weui-media-box_text  tanchuRow">
            <view style="flex:0.2">联系方式</view>
            <view class="weui-input" style="flex:1">
                <input placeholder="如：加我微信xdxmf0001" type="text" value="{{value_lianxi}}" name="inputVal_lianxi" />
            </view>
        </view>
        <view class="weui-media-box weui-media-box_text  tanchuRow">
            <view style="flex:0.2">备注信息</view>
            <view class="jianjie" style="flex:1;">
                <textarea class="weui-textarea" placeholder="如：不能再放行李" style="height:250rpx;" maxlength="200"
                    value="{{value_jianjie}}" name="inputVal_jianjie" bindinput="bindinputJianjie" />
                <view class="weui-textarea-counter"><span>{{inputNum}}</span>/200</view>
            </view>
        </view>

        <button form-type="submit" style="margin-top:50rpx;margin-bottom: 100rpx;" type="primary"
            disabled="{{isDisabled}}" wx:if="{{isEdit}}">确定</button>
        <button form-type="submit" style="margin-top:50rpx;margin-bottom: 100rpx;" type="primary"
            disabled="{{isDisabled}}" wx:if="{{!isEdit}}">提交发布</button>
    </form>
</view>
