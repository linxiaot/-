                <input placeholder="请填写" type="number" value="{{value_xinzi}}" maxlength="4" name="inputVal_xinzi" />
            </view>
        </view>
        <view class="weui-media-box weui-media-box_text flex tanchuRow">
            <view style="flex:0.2">联系人</view>
            <view class="weui-input" style="flex:1">
                <input placeholder="请输入" type="text" value="{{value_lianxiren}}" maxlength="15"
                    name="inputVal_lianxiren" />
            </view>
        </view>
        <view class="weui-media-box weui-media-box_text flex tanchuRow">
            <view style="flex:0.2">电话</view>
            <view class="weui-input" style="flex:1">
                <input placeholder="请输入" type="number" value="{{value_phone}}" maxlength="11" name="inputVal_phone"
                    bindinput="bindinputPhone" />
            </view>
        </view>
        <view class="weui-media-box weui-media-box_text  tanchuRow">
            <view style="flex:0.2">详细地址</view>
            <view class="weui-input" style="flex:1">
                <input placeholder="如：湘大南门联建美食街直走10号店铺" value="{{value_address}}" maxlength="50" type="text"
                    name="inputVal_address" />
            </view>
        </view>
        <view class="weui-media-box weui-media-box_text  tanchuRow">
            <view style="flex:0.2">工作内容</view>
            <view class="jianjie" style="flex:1;">
                <textarea class="weui-textarea" value="{{value_jianjie}}" placeholder="请输入" style="height:250rpx;"
                    maxlength="200" name="inputVal_jianjie" bindinput="bindinputJianjie" />
                <view class="weui-textarea-counter"><span>{{inputNum}}</span>/200</view>
            </view>
        </view>
        <button wx:if="{{isEdit}}" form-type="submit" style="position: relative; left: -30rpx; top: 20rpx"
            type="primary" disabled="{{isDisabled}}">确认</button>
        <button wx:if="{{!isEdit}}" form-type="submit" style="position: relative; left: -30rpx; top: 20rpx"
            type="primary" disabled="{{isDisabled}}">提交审核</button>
    </form>
</view>

<!-- ershou 建议-->
<view class="tanchu" wx:if="{{addType=='jianyi'}}">
    <view class="tanchuBiaoti">提交建议</view>
    <form bindsubmit="toTijiaoSubmit_jianyi">
        <view class="page__bd">

            <view class="weui-media-box weui-media-box_text  tanchuRow">
                <view style="flex:0.2">我的建议：</view>
                <view class="jianjie" style="flex:1;">
                    <textarea class="weui-textarea" placeholder="请输入内容" style="height:250rpx;" maxlength="500"
                        value="{{value_jianjie}}" name="inputVal_jianjie" bindinput="bindinputJianjie" />
                    <!-- <view class="weui-textarea-counter"><span>{{inputNum}}</span>/200</view> -->
                </view>
            </view>

            <mp-cells>
                <mp-cell>
                    <mp-uploader select="{{selectFile}}" files="{{files}}" max-count="1" binddelete="todelete"
                        title="图片上传" tips="可以提供图片给我们">
                    </mp-uploader>
                </mp-cell>
            </mp-cells>
        </view>

        <button form-type="submit" style="margin-top:50rpx;margin-bottom: 100rpx;" type="primary"
            disabled="{{isDisabled}}">确定</button>
    </form>
</view>