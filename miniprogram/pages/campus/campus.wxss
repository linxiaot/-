/* pages/campus/campus.wxss */
.container {
  padding: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 60rpx;
}

.campus-list {
  width: 100%;
}

.campus-item {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  text-align: center;
  font-size: 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.campus-item.selected {
  background: #07c160;
  color: #fff;
} 