<!-- 我的个人中心页面 -->
<!-- <mp-loading wx:if="{{showLoading}}" type="circle"></mp-loading> -->
<view class="weui-cell weui-cell_active" style="background-color: #8AD4AF;padding: 32rpx; margin: 0rpx;">
  <!-- 头像区域 -->
  <view class="weui-cell__hd" style="position: relative; margin-right: 30rpx; margin-left: 30rpx; margin-top: 30rpx;"
    wx:if="{{login_ok}}">
    <button class="userinfo-avatar"
      style="background-image: url({{avatarUrl}}); width: 120rpx; height: 120rpx; display: block; box-sizing: border-box"
      size="default" bindtap="toZiliao"></button>
    <!-- 性别角标 -->
    <text class="weui-badge" style="position: absolute; top: -0.4em; right: -0.4em;"
      wx:if="{{ balance!==0 }}">VIP</text>
    <view class="wanzhengdu" bindtap="toZiliao">
      <text>资料完整度</text>
      <text style="margin-left: 10rpx;">{{ziliaoPercent}}%</text>
    </view>
  </view>
  <!-- 资料 -->
  <view class="weui-cell__bd" wx:if="{{login_ok}}" style="margin-top:20rpx;">
    <view class="ziliao">
      <view class="ziliao_item1">
        <view class="ziliao_item1_item1">
          <view bindtap="toZiliao">{{nickName}}</view>
        </view>
        <view class="ziliao_item1_item2">
          <view bindtap="toMoney">钱包<text style="margin-left: 10rpx;">{{balance}}</text></view>
          <view style="width: 20rpx;text-align: center;">|</view>
          <view bindtap="toJifen">积分<text style="margin-left: 10rpx;">{{jifen_total}}</text> </view>
        </view>
      </view>
      <view class="ziliao_item2">
        <view class="qiandao" wx:if="{{!isQiandao}}">
          <view class="qiandao_item1" wx:if="{{!isEdit}}" bindtap="toQiandao">去签到</view>
          <view class="qiandao_item2" wx:if="{{!isEdit}}">今日签到积分+{{Val_jifen}}</view>
        </view>
        <view class="qiandao" wx:if="{{isQiandao}}">
          <view class="qiandao_item1" style="color: gray;" wx:if="{{!isEdit}}">已签到</view>
          <view class="qiandao_item2" wx:if="{{!isEdit}}">明日签到积分+{{Val_jifen_next}}</view>
        </view>

      </view>
    </view>
  </view> 
  <!-- 如果未登陆 显示以下 -->
  <view class="weui-cell__bd" wx:if="{{!login_ok}}" style="margin-top:20rpx;" bindtap="toZiliao">
    <view class="weui-flex">
      <image class="userinfo-avatar" src="{{Url}}" mode="cover"></image>
      <view style="font-size: 13px; color: #888;margin: auto;margin-left: 0;">点击登陆</view>
    </view>
  </view>
</view>
<!-- 我的订单 -->
<view class="dingdan">
  <view class="dingdan_item1" style="display: flex;justify-content: space-between;">
  <view>我的订单</view>
  <!-- <view style="font-size: small;" catchtap="toQita">其他 >></view> -->
  </view>
  <view class="dingdan_items">
    <view class="dingdan_item2" wx:for="{{dingdan_namelist}}" wx:key='index' bindtap="toDingdan" data-index="{{index}}">
      <view class="weui-grid__icon">
        <image mode="widthFix" style="width:{{index == 3?65:50}}rpx;" src="{{item.src}}"></image>
      </view>
      <view class="dingdan_item2_text">{{item.text}}</view>
    </view>
  </view>
</view>
<view class="page__bd">

  <!-- <view class="weui-cells__title">带图标、说明、跳转的列表项</view> -->
  <view class="weui-cells">
