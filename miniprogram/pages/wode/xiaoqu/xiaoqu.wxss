/* pages/wode/xiaoqu/xiaoqu.wxss */
.page__bd {
  padding: 30rpx;
}

.weui-cells__title {
  margin-top: 15px;
  margin-bottom: 8px;
  padding-left: 15px;
  padding-right: 15px;
  color: rgba(0, 0, 0, 0.5);
  font-size: 14px;
  line-height: 1.4;
}

.weui-cell {
  padding: 16px 15px;
  position: relative;
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
}

.weui-cell__bd {
  flex: 1;
}

.weui-cell__ft {
  text-align: right;
  color: rgba(0, 0, 0, 0.5);
  font-size: 14px;
  line-height: 1.4;
}

.weui-loadmore {
  width: 100%;
  height: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.weui-loadmore__tips {
  color: rgba(0, 0, 0, 0.3);
  font-size: 14px;
  line-height: 1.4;
} 