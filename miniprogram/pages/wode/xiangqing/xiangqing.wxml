    <view class="weui-form-preview__bd shenqingtuikuan">
      <view class="anniu">
        <view class="anniu_item_1">
          <text>退款中</text>
        </view>
      </view>
    </view>
  </view>
  <view class="zhuangtai" wx:if="{{dd_Status == '5'}}">
    <view style="text-align: center;">
      {{value_tkyy}}
    </view>
    <view class="weui-form-preview__bd shenqingtuikuan">
      <view class="anniu">
        <view class="anniu_item_1">
          <text>退款成功</text>
        </view>
      </view>
    </view>
  </view>
  <view class="zhuangtai" wx:if="{{dd_Status == '7'|| dd_Status == '8'}}">
    <view style="text-align: center;">
      {{'已装车，订单派送中'}}
    </view>
    <view class="weui-form-preview__bd shenqingtuikuan">
      <view class="anniu">
        <view class="anniu_item_1">
          <text>派送中</text>
        </view>
      </view>
    </view>
  </view>
  <view class="zhuangtai" wx:if="{{dd_Status == '6'}}">
    <view style="text-align: center;">
      {{value_tkyy}}
    </view>
    <view class="weui-form-preview__bd shenqingtuikuan">
      <view class="anniu">
        <view class="anniu_item_1">
