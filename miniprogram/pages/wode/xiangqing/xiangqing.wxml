<!-- 美食 订单详情 -->
<view class="content" wx:if="{{isMeishi}}">
  <view class="dianpu_info">
    <view class="dianpu_info_1">
      <view class="dianpu_info_icon">
        <mp-icon icon="location" color="black" size="{{25}}" type="field"></mp-icon>
      </view>
      <view style="margin-left: 10rpx;">
        <view class="content-title" style="font-weight: bold;">{{cartData.dianpu.dianpu_name}}</view>
        <view class="content-title">{{cartData.dianpu.dianpu_dizhi}}</view>
      </view>
    </view>
    <view class="dianpu_info_icon" bindtap="toPhoneCall">
      <image src="../../../images/phone.png" mode="widthFix" style="width:50rpx;"></image>
    </view>
  </view>
  <view class="order">
    <view class="order-title">
      <view>订单详情</view>
      <view class="dingdan_item2" wx:if="{{cartData.dd_Status=='0'}}">待出餐</view>
      <view class="dingdan_item2" wx:if="{{cartData.dd_Status=='3'}}">已送达</view>
      <view class="dingdan_item2" wx:if="{{cartData.dd_Status=='2'}}">配送中</view>
      <view class="dingdan_item2" wx:if="{{cartData.dd_Status=='4'}}">退款中</view>
      <view class="dingdan_item2" wx:if="{{cartData.dd_Status=='5'}}">退款成功</view>
      <view class="dingdan_item2" wx:if="{{cartData.dd_Status=='6'}}">退款失败</view>
    </view>
    <view class="order-list">
      <view class="order-item" wx:for="{{cartData.cartList}}" wx:key="id">
        <view class="order-item-l">
          <image class="order-item-image" mode="widthFix" src="{{item.imageUrl.imagefileID}}" />
          <view>
            <view class="order-item-name">{{item.name}}</view>
            <view class="order-item-number">x {{item.number}}</view>
          </view>
        </view>
        <view class="order-item-price">{{priceFormat(item.price * item.number)}}</view>
      </view>
      <!-- 优惠信息 -->
      <!-- <view class="order-item" wx:if="{{checkPromotion(promotion)}}">
        <view class="order-item-l">
          <i class="order-promotion-icon">减</i>优惠
        </view>
        <view class="order-promotion-price">- {{priceFormat(cartData.promotion)}}</view>
      </view> -->
      <view class="order-item">
        <view class="order-item-l">小计</view>
        <view class="order-total-price" style="font-size:small;">{{priceFormat(cartData.cartPrice -
          cartData.promotion)}}</view>
      </view>
      <view class="order-item">
        <view class="order-item-l">实付</view>
        <view class="order-total-price">{{priceFormat(cartData.shijiMoney)}}</view>
      </view>
      <view class="xiadanshijian flex ziti_small ziti_gary">
        <label>订单编号</label>
        <label>{{cartData.dingdanhao}}</label>
      </view>
      <view class="xiadanshijian flex ziti_small ziti_gary">
        <label>下单时间</label>
        <label>{{cartData.xd_time}}</label>
      </view>
      <view class="xiadanshijian flex ziti_small ziti_gary" wx:if="{{cartData.songda_time}}">
        <label>送达时间</label>
        <label>{{cartData.songda_time}}</label>
      </view>
      <view class="xiadanshijian flex ziti_small ziti_gary" wx:if="{{cartData.tytuikuan_time}}">
        <label>退款时间</label>
        <label>{{cartData.tytuikuan_time}}</label>
      </view>
    </view>
  </view>
  <view class="content-comment">
    <label style="font-size: small;">备注</label>
    <view>{{cartData.beizhu}}</view>
  </view>
  <!-- <view class="weui-form-preview__hd">
    <view class="weui-form-preview__item quhuoma">
      <em class="weui-form-preview__value">{{cartPrice}}</em>
    </view>
  </view>
  <view class="weui-form-preview__bd">
    <view class="weui-form-preview__item">
      <label class="weui-form-preview__label">创建时间</label>
      <text class="weui-form-preview__value">{{xd_time}}</text>
    </view>
  </view> -->
  <view class="weui-form-preview__bd shenqingtuikuan" wx:if="{{cartData.dd_Status == '0'}}">
    <view class="anniu2">
      <view class="anniu_item2" catchtap="toShenqing_tuikuan_meishi">
        <text>退款</text>
      </view>
    </view>
  </view>
  <view class="content-comment" wx:if="{{cartData.pingjia.pingjia_fenshu}}" style="margin-bottom: 50rpx;">
    <label style="font-size: small;">我的评价</label>
    <view class="xingji" style="font-size: small;">
      <view class="xingji_items1">
        <view class="" wx:for="{{cartData.xingji_list}}" wx:key="index">
          <image class="" style="width: 30rpx;height: 30rpx;" src="{{item}}"></image>
        </view>
      </view>
      <view class="xingji_items2">"{{pingjia_list[cartData.pingjia.pingjia_fenshu-1]}}"</view>
    </view>
    <view>{{cartData.pingjia.pingjia_text}}</view>
  </view>
</view>
