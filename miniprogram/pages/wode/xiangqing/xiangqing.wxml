<!-- 退款提交界面 -->
<!-- [弹窗] 下单信息 核对 -->
<mp-dialog title="退款" show="{{dialogShow}}" bindbuttontap="toShenqing_tuikuan" buttons="{{buttons}}">
  
  <view class="text-black" style="margin: 0rpx 30rpx;">
    <view wx:if="{{isHebingdingdan}}">
      <view class="text-sm">
        <!-- <view class="padding-xs bg-yellow light">合并订单需一起取消并退款</view> -->
        <view class="padding-xs bg-orange light">无法取消单一订单，合并订单将全部退款</view>
        <view class=" flex padding-xs solid-top text-left text-gray" wx:if="{{dingdanList.length>0}}">
          <view style="flex:0.15" class="text-gray"></view>
          <view style="flex:0.6">快递点</view>
          <view style="flex:1">取货码</view>
        </view>
        <view class="flex padding-xs solid-top text-left" wx:for="{{dingdanList}}" wx:key="index">
          <view style="flex:0.15" class="text-gray">{{index+1}}/{{dingdanList.length}}</view>
          <view style="flex:0.6">{{item.kd_Dian}}</view>
          <view style="flex:1" class="text-cut">{{item.qh_Ma}}</view>
          <!-- 删除一个包裹信息 -->
          <!-- <view style="flex:0.1" class="cuIcon-delete" catch:tap="removeQhm" data-index="{{index}}"></view> -->
        </view>
      </view>
      <!-- <view class="text-center" wx:if="{{dingdanList.length>=4}}">...</view> -->
      <view class="flex justify-end">
        <view class="jiezhang_items_1">
          <view class="jiezhang_item1">小计：</view>
          <view class="jiezhang_item1">{{dingdanList.length}} x</view>

          <view class="jiezhang_item2 margin-left-xs">￥{{dingdan_money}}</view>
        </view>
        <!-- <view class="jiezhang_items_1">
        <view class="jiezhang_item1">小计：</view>
        <view class="jiezhang_item2">￥{{dingdanList[0].dingdan_money*dingdanList.length}}</view>
      </view> -->
      </view>
    </view>
    <view class="dingdan_items">
      <view class="dingdan_item1"><text style="color: red;">*</text> 退款原因</view>
      <view class="{{value_tkyy==''?'dingdan_item2':'dingdan_item1'}}" catchtap="tochoose_tkyy">
        {{value_tkyy==''?'请选择':value_tkyy}} >
      </view>
    </view>
    <view wx:if="{{value_tkyy == '其他'}}" style="font-size: small;">（请提前与客服进行沟通）</view>
  </view>
  <view class="jiezhang">
    <view class="jiezhang_items_1">
      <view class="jiezhang_item1">退款金额：</view>
      <view class="jiezhang_item2">￥{{dingdanList.length>0?dingdan_money*dingdanList.length:dingdan_money}}</view>
    </view>
