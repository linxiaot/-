  height: 15rpx;
  /* background-color: #f0f0f0; */
}

.dingdan {
  padding: 0rpx 30rpx;
  height: 240rpx;
  display: flex;
  flex-direction: column;
  background: url(https://786d-xmf-0g87mzf198205ada-1305629196.tcb.qcloud.la/iamges_xitong/wode_beijingtu.png?sign=51a1c2f738fa339a1c5dac0d03d6dcbf&t=1628523246);
}

.dingdan_items {
  display: flex;
  flex: 1;
  background-color: white;

}

.dingdan_item1 {
  flex: 0.5;
  padding: 15rpx 30rpx;
  background-color: white;
  border-radius: 10rpx 10rpx 0rpx 0rpx;
}

.dingdan_item2 {
  font-size: small;
  flex: 1;
  text-align: center;
}

.dingdan_image {
  width: 30rpx;
  height: 30rpx;
}

.dingdan_item2_text{
  color: rgb(87, 87, 87);
