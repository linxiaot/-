}

.ziliao_item2 {
  flex: 0.6;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.ziliao_item1_item1 {
  flex: 1;
  display: flex;
  align-items: center;
  font-weight: bold;
  padding: 15rpx 0rpx;

}

.ziliao_item1_item2 {
  padding: 15rpx 0rpx;

  display: flex;
  flex: 1;
  align-items: center;
  font-size: 26rpx;
