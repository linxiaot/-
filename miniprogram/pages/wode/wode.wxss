.qiandao {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qiandao_item1 {
  text-align: center;
  border-radius: 8rpx;
  background-color: gold;
  padding: 5rpx 5rpx;
  width: 100rpx;
  font-size: small;
}

.qiandao_item2 {
  margin-left: 10rpx;
