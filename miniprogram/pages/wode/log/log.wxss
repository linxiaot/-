/* pages/wode/log/log.wxss */
.container {
  padding: 20rpx;
  background-color: #f6f6f6;
  min-height: 100vh;
}

.log-list {
  width: 100%;
}

.log-item {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.log-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.log-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 添加空状态样式 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
} 