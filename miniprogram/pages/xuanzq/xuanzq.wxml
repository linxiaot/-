            <view class="danxuan" style="margin-right: 0rpx;">
              <checkbox class="" value="{{index}}" checked="{{item.checked}}" />
            </view>
            <view style="display: flex;width: 630rpx;">
              <view style="flex:0.4;">
                <text user-select='true' style="background-color: gold;padding: 5rpx;">{{item.dingdanhaoSuo}}</text>
              </view>
              <view style="flex:1;">
                <text user-select='true'>{{item.qh_Ma}}</text>
              </view>
              <view style="flex:0.7;">
                <text user-select='true'>{{item.kd_Name}}</text>
              </view>
              <view style="flex:1;">
                <text user-select='true'>{{item.kd_PhoNum}}</text>
              </view>
              <view style="flex:1.2;">
                <text user-select='true'>{{item.sd_Didian}}</text>
              </view>
              <view style="flex:0.9;">
                <text user-select='true'>{{item.kd_Dian}}</text>
              </view>
              <view style="flex:1.4;" style="padding-left: 5rpx;">
                <text user-select='true'>{{item.xd_time}}</text>
              </view>
              <view style="padding-left: 3rpx;" wx:if="{{item.dd_Status=='2'}}">
                <text class="text-red">取</text>
              </view>
              <!-- <view style="padding-left: 3rpx;" wx:if="{{item.dd_Status=='2'}}">
                <text class="text-blue">派</text>
              </view>
              <view style="padding-left: 3rpx;" wx:if="{{item.dd_Status=='2'}}">
                <text class="text-blue">拒</text>
              </view> -->

            </view>
          </view>
        </checkbox-group>

        <!--预约寄件 列表-->
        <checkbox-group bindchange="checkboxChange_danxuan_jj">
          <view wx:if="{{isJijian}}" wx:for="{{chaxunList}}" wx:key="index" class="weui-flex" style="border-bottom: 2rpx solid #dcdcdc;color: {{item.isYiqu==true? 'gray':''}};">
            <view class="danxuan" style="margin-right: 5rpx;">
              <checkbox class="" value="{{index}}" checked="{{item.checked}}" />
            </view>
            <text user-select='true' style="margin-bottom: 10rpx; font-size:15rpx;flex:0.8;">{{item.JJ_Didian}}</text>
            <text user-select='true' style="margin-bottom: 10rpx; font-size:15rpx;flex:0.5;">{{item.JJ_Name}}</text>
            <text user-select='true' style="margin-bottom: 10rpx; font-size:15rpx;flex:0.9;">{{item.JJ_PhoNum}}</text>
            <text user-select='true' style="margin-bottom: 10rpx; font-size:15rpx;flex:1.7;">{{item.mdd}}</text>
            <text user-select='true' style="margin-bottom: 10rpx; font-size:15rpx;flex:0.5;">{{item.qujTime}}</text>
            <text user-select='true' style="margin-bottom: 10rpx; font-size:15rpx;flex:0.4;text-align:center; ">{{item.JJ_weight}}</text>
            <text user-select='true' style="margin-bottom: 10rpx; font-size:15rpx;flex:0.5;">{{item.qujWupin}}</text>
            <text user-select='true' style="margin-bottom: 10rpx; font-size:15rpx;flex:0.8;">{{item.xd_time}}</text>
          </view>
        </checkbox-group>

      </view>
      <view class="weui-loadmore weui-loadmore_line" wx:if="{{!isChaxun_Daiqu}}">
        <text class="weui-loadmore__tips weui-loadmore__tips_in-line">无更多数据</text>
      </view>
    </view>
  </view>

  <!-- 登陆界面 -->
  <view class="weui-form" wx:if="{{!isAdmin}}">
    <view class="weui-form__text-area">
      <h2 class="weui-form__title">管理员登陆</h2>
      <view class="weui-form__desc">仅限管理员</view>

    </view>
    <view class="weui-form__control-area">
      <view class="weui-cells__group weui-cells__group_form">
        <view class="weui-cells weui-cells_form">
        </view>
      </view>
    </view>
    <view class="weui-form__opr-area" bindtap="toGuanli">
      <a class="weui-btn weui-btn_primary weui-btn_disabled">管理员授权登陆</a>
    </view>
  </view>
</view>
<!-- 店铺选择列表 -->
<view class="mask" style="height: {{screenHeight}}px;" catchtap="close_dianpu" wx:if="{{ isShow_dianpu && isBanner}}">
  <scroll-view class="xueyuan" style="height: {{screenHeight}}px;" scroll-y>
    <view style="text-align: center;height: 40rpx;font-weight: bold;" wx:if="{{!isQita}}">选择{{bannerIndex+1}}号广告图的跳转店铺
    </view>
    <!-- <view>
      <input type="text" catchinput="onInput_dianpuSearch" placeholder="店铺搜索：如店铺名，手机号" />
    </view> -->
    <view wx:for="{{shangjiaList}}" wx:key="list_index" wx:for-item="list_item" wx:for-index="list_index">
      <view class="xueyuan_name" style="padding: {{(screenHeight/23-20.8)/2}}px 30rpx;" catchtap="tapchange_dianpu" data-dianpu_id="{{list_item._id}}" data-dianpu_name="{{list_item.name}}">
        {{list_item.name}}
        <text style="font-size: small;" wx:if="{{list_item.checked}}">▼</text>
      </view>
    </view>
  </scroll-view>
</view>
<!-- 店铺选择列表 分账-->
<view class="mask" style="height: {{screenHeight}}px;" catchtap="close_dianpu" wx:if="{{isShow_dianpu && isQita}}">
  <scroll-view class="xueyuan" style="height: {{screenHeight}}px;" scroll-y>

    <view wx:for="{{shangjiaList}}" wx:key="list_index" wx:for-item="list_item" wx:for-index="list_index">
      <view class="dianpu_items" style="padding: {{(screenHeight/23-20.8)/2}}px 30rpx;" catchtap="tapchange_fenzhang" data-dianpu_id="{{list_item._id}}" data-dianpu_isfenzhang="{{list_item.isFenzhang}}" data-dianpu_openid="{{list_item._openid}}" data-index="{{index}}">
        <view style="width: 200rpx;">{{list_item.name}}</view>

        <!-- <text style="font-size: small;" wx:if="{{list_item.isFenzhang}}">▼</text> -->
        <view class="dianpu_item1" style="" wx:if="{{list_item.isFenzhang}}">
          <view class="dianpu_item1_item">正在分账</view>
        </view>
        <view class="dianpu_item2">
          <view class="dianpu_item2_item">{{list_item.isFenzhang?'取消':'添加'}}</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>