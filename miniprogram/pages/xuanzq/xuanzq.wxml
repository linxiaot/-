<view class="page">
  <view class="page__hd" wx:if="{{isAdmin}}">
    <!-- 顶部切换 -->
    <view class="chaxun">
      <view class="toubu" style="margin-top:30rpx;margin-bottom:20rpx;">
        <view class="{{isDaiqu ? 'class_toTap' : 'class_unTap'}}" style="flex:1; text-align:center; " hover-class="hover" bindtap="tapDaiqu">代取</view>
        <view class="{{isJijian ? 'class_toTap' : 'class_unTap'}}" style="flex:1; text-align:center; border-left: 2rpx solid black;" hover-class="hover" bindtap="tapJijian">寄件
        </view>
        <view class="{{isPaotui ? 'class_toTap' : 'class_unTap'}}" style="flex:1; text-align:center; border-left: 2rpx solid black;" hover-class="hover" bindtap="tapPaotui">跑腿
        </view>
        <view class="{{isBanner ? 'class_toTap' : 'class_unTap'}}" style="flex:1; text-align:center; border-left: 2rpx solid black;" hover-class="hover" bindtap="tapBanner">广告
        </view>
        <view class="{{isTuikuan ? 'class_toTap' : 'class_unTap'}}" style="flex:1; text-align:center; border-left: 2rpx solid black;" hover-class="hover" bindtap="tapTuikuan">退款
        </view>
        <view class="{{isQita ? 'class_toTap' : 'class_unTap'}}" style="flex:1; text-align:center; border-left: 2rpx solid black;" hover-class="hover" bindtap="tapQita">其他
        </view>
      </view>
    </view>

    <!-- 其他 -->
    <view class="qita" wx:if="{{isQita}}">
      <!--课表 -->
      <view class="kebiao">
        <view>课表数据</view>
        <view class="" style="font-size: small;color: gray;" hover-class="hover" catchtap="toKebiao">
          <view style="display: flex;" wx:if="{{!isKebiao}}">
            <view>查看</view>
            <view style="margin-left: 10rpx;">></view>
          </view>
          <view style="display: flex;" wx:if="{{isKebiao}}">
            <view>收起</view>
            <view style="margin-left: 10rpx;">﹀</view>
          </view>
        </view>
      </view>
      <view class="kebiao" wx:if="{{isKebiao}}">
        <view style="font-size: small;color: gray;">所有课表原始数据将被清空</view>
        <view class="anniu_item" style="width: 150rpx;" hover-class="hover" catchtap="toQingkong_kebiao">
          <view class="anniu_item_item">去清空</view>
        </view>
      </view>
      <!--短信识别 -->
      <view class="kebiao">
        <view>短信识别设置</view>
        <view class="" style="font-size: small;color: gray;" hover-class="hover" catchtap="toDuanxin">
          <view style="display: flex;" wx:if="{{!isDuanxin}}">
            <view>查看</view>
            <view style="margin-left: 10rpx;">></view>
          </view>
          <view style="display: flex;" wx:if="{{isDuanxin}}">
            <view>收起</view>
            <view style="margin-left: 10rpx;">﹀</view>
          </view>
        </view>
      </view>
      <view class="kebiao" wx:if="{{isDuanxin}}" style="flex-direction: column;">
        <view style="font-size: small;color: gray;">短信提取设置</view>
        <!-- 短信列表 -->
        <view class="tuikuan_items">
          <view class="dingdan" wx:for="{{duanxin_list}}" wx:key="index">
            <view class="dingdan_tuikuan" style="width: 100%;">
              <view class="dingdan_items">
                <view class="dingdan_item1" style="width: 80rpx;">短信内容</view>
                <!-- <view class="dingdan_item2 jiacu">{{item.text}}</view> -->
                <textarea class="weui-input" style="color: blue;" type="text" placeholder="请输入" name="" placeholder-class="weui-input__placeholder" value="{{item.text}}" bindinput="onInput_text" data-index="{{index}}" auto-height />
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">区分短信关键词1</view>
                <view class="dingdan_item2 jiacu">
                  <input class="weui-input duanxin_input" type="text" placeholder="请输入" name="" placeholder-class="weui-input__placeholder" value="{{item.keyword1}}" bindinput="onInput_keyword1" data-index="{{index}}" />
                </view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">区分短信关键词2</view>
                <view class="dingdan_item2 jiacu">
                  <input class="weui-input duanxin_input" type="text" placeholder="请输入" name="" placeholder-class="weui-input__placeholder" value="{{item.keyword2}}" bindinput="onInput_keyword2" data-index="{{index}}" />
                </view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">快递点</view>
                <view class="dingdan_item2 jiacu">
                  <input class="weui-input duanxin_input" type="text" placeholder="请输入" name="" placeholder-class="weui-input__placeholder" value="{{item.kd_Dian}}" bindinput="onInput_kd_Dian" data-index="{{index}}" />
                </view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">提取开始关键字</view>
                <view class="dingdan_item2 jiacu">
                  <input class="weui-input duanxin_input" type="text" placeholder="请输入" name="" placeholder-class="weui-input__placeholder" value="{{item.starNum_word}}" bindinput="onInput_starNum_word" data-index="{{index}}" />
                </view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">提取结束关键字</view>
                <view class="dingdan_item2 jiacu">
                  <input class="weui-input duanxin_input" type="text" placeholder="请输入" name="" placeholder-class="weui-input__placeholder" value="{{item.endNum_word}}" bindinput="onInput_endNum_word" data-index="{{index}}" />
                </view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">开始关键字偏移量</view>
                <view class="dingdan_item2 jiacu">
                  <input class="weui-input duanxin_input" type="number" placeholder="请输入" name="" placeholder-class="weui-input__placeholder" value="{{item.numjia}}" bindinput="onInput_numjia" data-index="{{index}}" />
                </view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">结束关键字偏移量</view>
                <view class="dingdan_item2 jiacu">
                  <input class="weui-input duanxin_input" type="number" placeholder="请输入" name="" placeholder-class="weui-input__placeholder" value="{{item.numjian}}" bindinput="onInput_numjian" data-index="{{index}}" />
                </view>
              </view>
              <view class="flex_center" style="border-top: 2rpx solid #dcdcdc;">
                <view class="" style="color: #F5835E;font-size: small;" bindtap="toDel_duanxin" data-index="{{index}}" hover-class="hover">删除</view>
              </view>
            </view>
          </view>
          <view class="weui-media-box weui-media-box_text" style="display:flex;justify-content:center;background-color:#dcdcdc" bindtap="toAdd_duanxin">
            +添加
          </view>
          <view class="" style="display: flex;justify-content: center;align-items: center;margin-top: 20rpx;">
            <view class="anniu_item" style="width: 300rpx;" bindtap="toBiangeng" hover-class="hover">确认变更</view>
          </view>
          <view style="font-size: small;color: gray;">设置方法举例</view>
          <image src="cloud://xmf-0g87mzf198205ada.786d-xmf-0g87mzf198205ada-1305629196/banner/短信修改方法.png"></image>
        </view>
      </view>
      <!-- 美食提现 -->
      <view class="kebiao">
        <view>美食商家提现</view>
        <!-- <view class="anniu_item" style="width: 200rpx;" hover-class="hover" catchtap="fenzhang_Guanli"> -->
        <view class="" style="font-size: small;color: gray;" hover-class="hover" catchtap="toTixian">
          <view style="display: flex;" wx:if="{{!isTixian}}">
            <view>查看</view>
            <view style="margin-left: 10rpx;">></view>
          </view>
          <view style="display: flex;" wx:if="{{isTixian}}">
            <view>收起</view>
            <view style="margin-left: 10rpx;">﹀</view>
          </view>
        </view>
      </view>
      <view style="margin-top: 20rpx;" wx:if="{{isTixian}}">
        <view style="display: flex;font-size: small;justify-content: space-between;margin-bottom: 20rpx;" catchtap="toCopy_appid">
          <view>公众号的APPID：</view>
          <view>{{val_appid}}</view>
          <view>复制</view>
        </view>
        <view class="tuikuan_biaoti">
          <!-- <view class="tuikuan_item1" bindtap="checkbox_Quanxuan">
            <image style="width: 45rpx;height: 45rpx;"
              src="{{isQuanxuan?'../../images/danxuanxuanzhong.png':'../../images/danxuanweixuan.png'}}"></image>
            <view style="margin-left: 20rpx;">
              <text>全选</text>
              <text style="margin-left: 5rpx;">({{xuanze_num}})</text>
            </view>
          </view> -->
          <view class="tuikuan_search" bindtap="quxiaoQuanxuan">
            <image style="width: 30rpx;height: 30rpx;" src="cloud://xmf-0g87mzf198205ada.786d-xmf-0g87mzf198205ada-1305629196/banner/tubiao/qiang/yonghuchaxun.png"></image>
            <view>
              <input type="text" placeholder="搜索" bindinput="input_tixian" />
            </view>
          </view>
          <view class="shaixuan" style="" wx:for="{{shaixuan_namelist}}" wx:key="index">
            <view class="shaixuan_items" style="color: {{item.checked?'#F5835E':''}};" catchtap="toShaixuan" hover-class="hover" data-item="{{item}}" data-index="{{index}}">{{item.text}}</view>
            <view class="red_dot" wx:if="{{index == 0}}">
              <view style="font-size: {{tixian_list.leng>=100?'16':''}}rpx;">{{tixian_list.length}}</view>
            </view>
            <view class="red_dot" wx:if="{{item.checked && index == 1}}">
              <view style="font-size: {{searchlist_tixian.leng>=100?'16':''}}rpx;">{{searchlist_tixian.length}}</view>
            </view>
            <view class="red_dot" wx:if="{{item.checked && index == 2}}">
              <view style="font-size: {{searchlist_tixian.leng>=100?'16':''}}rpx;">{{searchlist_tixian.length}}</view>
            </view>
          </view>
        </view>
        <view class="zanwu" wx:if="{{tixian_list.length == 0}}">
          <view>暂无数据</view>
        </view>
        <!-- 提现 列表 -->
        <view class="tuikuan_items" wx:if="{{searchlist_tixian.length == 0}}">

          <view class="dingdan" wx:for="{{tixian_list}}" wx:key="index">
            <view class="dingdan_tuikuan" style="width: {{item.isJiesuan?'100%':''}};">

              <view class="dingdan_items">
                <view class="dingdan_item1">店铺名称</view>
                <view class="dingdan_item2 jiacu">{{item.dianpu_name}}</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">店铺电话</view>
                <view class="dingdan_item2 jiacu">{{item.dianpu_phone}}</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">Openid</view>
                <view class="dingdan_item2 jiacu" catchtap="toCopy" data-value="{{item._openid}}">{{item._openid}}
                </view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">提现金额</view>
                <view class="dingdan_item2 jiacu" style="color: #F5835E;" catchtap="toCopy" data-value="{{item.val_tixian}}">¥{{item.val_tixian}}</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">申请提现</view>
                <view class="dingdan_item2">{{item.xd_time}}</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">服务费率</view>
                <view class="dingdan_item2">{{item.fuwu_percent*100}}%</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">订单金额</view>
                <view class="dingdan_item2">¥{{item.dingdan_tixian}}</view>
              </view>
              <view class="dingdan_items" wx:if="{{item.isJiesuan == true}}" style="color: #F5835E;">
                <view>提现完成</view>
                <view>{{item.tx_time}}</view>
              </view>
            </view>
            <view class="" style="display: flex;justify-content: center;align-items: center;">
              <view class="anniu_item" style="width: 80rpx;" bindtap="goTixian" hover-class="hover" data-item="{{item}}" data-index="{{index}}" wx:if="{{item.isJiesuan == false}}">提现</view>
            </view>
          </view>

        </view>
        <!-- 提现 搜索结果 -->
        <view class="tuikuan_items" wx:if="{{searchlist_tixian.length !== 0}}">

          <view class="dingdan" wx:for="{{searchlist_tixian}}" wx:key="index">
            <view class="dingdan_tuikuan" style="width: {{item.isJiesuan?'100%':''}};">

              <view class="dingdan_items">
                <view class="dingdan_item1">店铺名称</view>
                <view class="dingdan_item2 jiacu">{{item.dianpu_name}}</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">店铺电话</view>
                <view class="dingdan_item2 jiacu">{{item.dianpu_phone}}</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">Openid</view>
                <view class="dingdan_item2 jiacu" catchtap="toCopy" data-value="{{item._openid}}">{{item._openid}}
                </view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">提现金额</view>
                <view class="dingdan_item2 jiacu" style="color: #F5835E;" catchtap="toCopy" data-value="{{item.val_tixian}}">¥{{item.val_tixian}}</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">申请提现</view>
                <view class="dingdan_item2">{{item.xd_time}}</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">服务费率</view>
                <view class="dingdan_item2">{{item.fuwu_percent*100}}%</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1">订单金额</view>
                <view class="dingdan_item2">¥{{item.dingdan_tixian}}</view>
              </view>
              <view class="dingdan_items" wx:if="{{item.isJiesuan == true}}" style="color: #F5835E;">
                <view>提现完成</view>
                <view>{{item.tx_time}}</view>
              </view>
            </view>
            <view class="" style="display: flex;justify-content: center;align-items: center;" wx:if="{{item.isJiesuan == false}}">
              <view class="anniu_item" style="" bindtap="goTixian" hover-class="hover" data-item="{{item}}" data-index="{{index}}">提现</view>
            </view>
          </view>

        </view>
        <view class="weui-loadmore weui-loadmore_line" wx:if="{{isnomore}}">
          <text class="weui-loadmore__tips weui-loadmore__tips_in-line" style="font-size: small;">无更多数据</text>
        </view>
      </view>
      <!--其他版块 -->
      <!-- <view class="kebiao">
        <view>其他版块设置</view>
        <view class="" style="font-size: small;color: gray;" hover-class="hover" catchtap="toQita_bankuai">
          <view style="display: flex;" wx:if="{{!isQita_bankuai}}">
            <view>查看</view>
            <view style="margin-left: 10rpx;">></view>
          </view>
          <view style="display: flex;" wx:if="{{isQita_bankuai}}">
            <view>收起</view>
            <view style="margin-left: 10rpx;">﹀</view>
          </view>
        </view>
      </view>
      <view class="kebiao" wx:if="{{isQita_bankuai}}" style="flex-direction: column;">
        <view style="font-size: small;color: gray;">其他版块设置</view>
      </view> -->
    </view>


    <!-- 广告 -->
    <view class="banner" wx:if="{{isBanner}}">
      <xuanxiangka typeNum="1" nameList='{{nameList}}' binditemChange='tochangeItem'></xuanxiangka>
      <view style="font-size: small;" wx:if="{{nameList[1].checked}}">广告轮播图尺寸：建议宽高比 750x300</view>
      <view style="font-size: small;" wx:if="{{!nameList[1].checked}}">广告轮播图：建议宽高比750x422（即1920x1080像素）</view>
      <!-- 广告图列表 -->
      <view class="banner_items" wx:for="{{imagesUrlList}}" wx:key="index">
        <view class="banner_item">
          <view class="banner_item_item">
            <image mode="scaleToFill" src="{{item.src}}" wx:if="{{item.src !== ''}}"></image>
            <image mode="widthFix" src="../../images/shangchuantupian.png" bindtap="toimageChoose" data-index="{{index}}" wx:if="{{item.src == ''}}" style="width: 100rpx;"></image>
          </view>
          <view class="banner_del">
            <view class="banner_num">{{index+1}}</view>
            <view style="color: red;" wx:if="{{item.src !== ''}}" bindtap="toDel" data-index="{{index}}">删除</view>
          </view>
        </view>
        <view class="tiaozhuan" wx:if="{{nameList[1].checked}}">
          <view class="tiaozhuan_item1">
            <view style="color: gray;border-left: 10rpx solid #8AD4AF;padding-left: 10rpx;">跳转</view>
            <view class="tiaozhuan_item1_item2" catchtap="open_dianpu" data-index="{{index}}">去选择</view>
          </view>
          <view class="">店铺：{{item.dianpu_name}}</view>
          <view class="">ID：{{item.dianpu_id}}</view>
        </view>

      </view>
      <view class="kaiguan" wx:if="{{nameList[0].checked}}">
        <view class="kaiguan_item">
          <view>开启以上广告</view>
          <switch bindchange="toBannerOpen" checked="{{bannerOpen_shouye}}" />
        </view>
        <view class="kaiguan_item">
          <view>流量主广告</view>
          <switch bindchange="toBannerOpen_ad" checked="{{bannerOpen_shouye_ad}}" />
        </view>
      </view>
    </view>
    <!-- 跑腿 -->
    <view class="tuikuan" wx:if="{{isPaotui}}">
      <view class="tuikuan_biaoti">
        <view class="tuikuan_item1" bindtap="checkbox_Quanxuan_pt">
          <image style="width: 45rpx;height: 45rpx;" src="{{isQuanxuan_pt?'../../images/danxuanxuanzhong.png':'../../images/danxuanweixuan.png'}}"></image>
          <view style="margin-left: 20rpx;">
            <text>全选</text>
            <text style="margin-left: 5rpx;">({{xuanze_num_pt}})</text>
          </view>
        </view>
        <view class="tuikuan_search" bindtap="quxiaoQuanxuan_pt">
          <image style="width: 30rpx;height: 30rpx;" src="cloud://xmf-0g87mzf198205ada.786d-xmf-0g87mzf198205ada-1305629196/banner/tubiao/qiang/yonghuchaxun.png"></image>
          <view>
            <input type="text" placeholder="搜索" bindinput="input_paotui" />
          </view>
        </view>
        <view class="anniu">
          <view class="anniu_item" bindtap="goPaotui_wancheng" hover-class="hover">完成</view>
        </view>
        <view class="anniu">
          <view class="anniu_item" bindtap="goPaotui_cancel" hover-class="hover">取消</view>
        </view>
      </view>
      <view class="zanwu" wx:if="{{paotuiList.length == 0}}">
        <view>暂无数据</view>
      </view>
      <!-- 跑腿 订单列表 -->
      <view class="tuikuan_items" wx:if="{{searchlist_paotui.length == 0}}">
        <checkbox-group bindchange="checkboxChange_danxuan_pt">
          <view class="dingdan" wx:for="{{paotuiList}}" wx:key="index">
            <view class="danxuan">
              <!-- <image style="width: 45rpx;height: 45rpx;" src="../../images/danxuanweixuan.png"></image> -->
              <!-- <checkbox class="weui-check" value="{{index}}" checked="{{item.checked}}" /> -->
              <checkbox class="" value="{{index}}" checked="{{item.checked}}" />

            </view>
            <view class="dingdan_tuikuan">
              <view class="dingdan_items">
                <view class="dingdan_item1_pt">需求</view>
                <view class="dingdan_item2 jiacu">{{item.xuqiu}}</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1_pt">姓名</view>
                <view class="dingdan_item2">{{item.paotui_name}}</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1_pt">手机</view>
                <view class="dingdan_item2" data-value="{{item.phone}}" bindtap="toCopy">{{item.phone}}
                </view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1_pt">地址</view>
                <view class="dingdan_item2">{{item.xxDizhi}}</view>
              </view>

              <view class="dingdan_items">
                <view class="dingdan_item1_pt">下单</view>
                <view class="dingdan_item2">{{item.xd_time}}</view>
              </view>
            </view>
          </view>
        </checkbox-group>
      </view>
      <!-- 跑腿 搜索结果 -->
      <view class="tuikuan_items" wx:if="{{searchlist_paotui.length !== 0}}">
        <checkbox-group bindchange="checkboxChange_danxuan_pt">
          <view class="dingdan" wx:for="{{searchlist_paotui}}" wx:key="index">
            <view class="danxuan">
              <!-- <image style="width: 45rpx;height: 45rpx;" src="../../images/danxuanweixuan.png"></image> -->
              <!-- <checkbox class="weui-check" value="{{index}}" checked="{{item.checked}}" /> -->
              <checkbox class="" value="{{index}}" checked="{{item.checked}}" />

            </view>
            <view class="dingdan_tuikuan">
              <view class="dingdan_items">
                <view class="dingdan_item1_pt">需求</view>
                <view class="dingdan_item2 jiacu">{{item.xuqiu}}</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1_pt">姓名</view>
                <view class="dingdan_item2">{{item.paotui_name}}</view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1_pt">手机</view>
                <view class="dingdan_item2" data-value="{{item.phone}}" bindtap="toCopy">{{item.phone}}
                </view>
              </view>
              <view class="dingdan_items">
                <view class="dingdan_item1_pt">地址</view>
                <view class="dingdan_item2">{{item.xxDizhi}}</view>
              </view>

              <view class="dingdan_items">
                <view class="dingdan_item1_pt">下单</view>
                <view class="dingdan_item2">{{item.xd_time}}</view>
              </view>
            </view>
          </view>
        </checkbox-group>
      </view>
    </view>
    <!-- 退款 -->
    <view class="tuikuan" wx:if="{{isTuikuan}}">
      <!-- 查询退款 -->
      <form bindsubmit="chaxunTuikuan">
        <view class="flex justify-between">
          <input class="text-sm" placeholder="输入F开头的订单号" style="width: 100%;" name="dingdanhao"></input>
          <button class="cu-btn sm bg-green shadow" form-type="submit">查询退款</button>
