}

.zhuce_item {
    text-align: center;
    height: 70rpx;
    width: 200rpx;
    margin: 0 20rpx;
    border-radius: 70rpx;
    border: 2rpx solid #ECECEC;
    line-height: 70rpx;
    background-color: white;
}

.zhuce_item_selected {
    background: #FFFBF1;
    border-color: #FFE9B7;
    /* color: #FFE6B4; */
    color: goldenrod;
}

.food_zhiding{
    border: 2rpx solid #8AD4AF;
    color: #8AD4AF;
    border-radius: 10rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 20rpx;
  }
  .food_zhiding_checked{
    border: 2rpx solid #8AD4AF;
    border-radius: 10rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #8AD4AF;
    color: white;
    font-size: 20rpx;

  }
.xuanfu{
    position: fixed;
    bottom: 20rpx;
    display: flex;
    justify-content: center;
    margin: auto;
    width: 100%;
    z-index: 1000;
}
.xuanfu_item{
    width: 184px;
    height: 40px;
    border-radius: 10rpx;
    color: black;
    font-size: medium;
    font-weight: bolder;
    background-color: #f5845e;
}

