.zhuce {
    display: flex;
    flex-direction: column;
    height: 300rpx;
    text-align: center;
    justify-content: center;
    align-items: center;
}

.zhuce view {
    margin: 30rpx;
    /* justify-content: space-between; */
}

.food_item {
    flex: 1;
    align-items: center;
}
.food_item_anniu {
    flex: 0.6;
    margin-left: 5rpx;
}

.food_item_image {
    /* flex: 0.3; */
