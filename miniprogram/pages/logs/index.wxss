.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  padding: 20rpx 0;
  text-align: center;
  background: #fff;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #666;
}

.log-list {
  height: calc(100vh - 120rpx);
}

.log-item {
  background: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #eee;
}

.module {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: bold;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.log-content {
  font-size: 26rpx;
}

.operation, .detail, .result {
  margin-bottom: 10rpx;
}

.label {
  color: #666;
  margin-right: 10rpx;
}

.success {
  color: #07c160;
}

.error {
  color: #ff4d4f;
}

.empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
} 